{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Build & Run Eden City",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/bin/EdenCity.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/build/bin",
            "environment": [],
            "externalConsole": true,
            "MIMode": "gdb",
            "miDebuggerPath": "G:/CodeBlocks/MinGW/bin/gdb.exe",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "Build EdenCity"
        }
    ]
}
